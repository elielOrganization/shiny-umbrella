<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center">

    <LinearLayout
        android:layout_width="280sp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_dialog_white"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/img_success_icon"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/ic_umbrella_logo_success"
            android:contentDescription="Umbrella Success" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Salida autorizada"
            android:textColor="#2E7D32"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="El registro se ha completado correctamente en el sistema."
            android:textAlignment="center"
            android:textColor="@color/black" />

        <View
            android:layout_width="60dp"
            android:layout_height="4dp"
            android:layout_marginTop="20dp"
            android:background="#2E7D32" />

        <TextView
            android:id="@+id/txt_uid_report"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="UID: 000000"
            android:textColor="#66000000"
            android:textSize="12sp"
            android:fontFamily="monospace" />

    </LinearLayout>
</FrameLayout>