<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center">

    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_dialog_white"
        android:orientation="vertical">

        <!-- Cabecera roja con el paraguas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:background="@drawable/shape_dialog_header_error"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/img_error_icon"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/ic_umbrella_logo_error"
                android:contentDescription="Denegado" />
        </LinearLayout>

        <!-- Contenido blanco -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingLeft="28dp"
            android:paddingRight="28dp"
            android:paddingTop="24dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Salida Denegada"
                android:textColor="#C62828"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Este alumno no cuenta con los permisos necesarios."
                android:textAlignment="center"
                android:textColor="@color/umbrella_text_secondary"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.4" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp"
                android:background="@color/umbrella_divider" />

            <TextView
                android:id="@+id/txt_uid_report"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre Alumno"
                android:textColor="@color/umbrella_red"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
