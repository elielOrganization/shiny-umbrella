<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/umbrella_white"
    android:padding="24dp">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="60dp"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/logo_umbrella"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_umbrella_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="SHINY UMBRELLA"
            android:textColor="@color/umbrella_blue_dark"
            android:textSize="16sp"
            android:letterSpacing="0.1"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IES SAN JUAN DE LA RAMBLA"
            android:textColor="#A0A0A0"
            android:textSize="12sp"
            android:textStyle="normal" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/button_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical">

        <Button
            android:id="@+id/btn_recreo"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginBottom="16dp"
            android:text="Verificar Recreo"
            android:textSize="18sp"
            android:backgroundTint="@color/umbrella_blue_primary"
            android:textColor="@color/umbrella_white"
            app:cornerRadius="20dp"
            android:elevation="6dp" />

        <Button
            android:id="@+id/btn_transporte"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:text="Verificar Transporte"
            android:textSize="18sp"
            android:backgroundTint="@color/umbrella_blue_primary"
            android:textColor="@color/umbrella_white"
            app:cornerRadius="20dp"
            android:elevation="6dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/button_container"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.05"
            android:text="ÚLTIMO MOVIMIENTO REGISTRADO"
            android:textColor="#888888"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_ultimo_movimiento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Sin registros en esta sesión"
            android:textColor="@color/umbrella_blue_dark"
            android:textSize="15sp"
            android:textStyle="italic"
            android:gravity="center" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp"
        android:text="Sistema de Control de Estudiantes v1.0"
        android:textColor="#44000000"
        android:textSize="11sp" />

</RelativeLayout>