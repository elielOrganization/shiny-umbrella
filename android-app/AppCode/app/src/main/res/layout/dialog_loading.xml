<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="center"
        app:cardCornerRadius="28dp"
        app:cardElevation="16dp"
        app:cardBackgroundColor="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgLoadingUmbrella"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_umbrella_logo"
                android:contentDescription="Verificando" />

            <TextView
                android:id="@+id/txtLoadingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="VERIFICANDO"
                android:textColor="@color/umbrella_blue_dark"
                android:textSize="13sp"
                android:letterSpacing="0.1"
                android:textStyle="bold" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:indeterminate="true"
                app:indicatorColor="@color/umbrella_blue_primary"
                app:trackColor="@color/umbrella_blue_light"
                app:indicatorSize="28dp"
                app:trackThickness="3dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>