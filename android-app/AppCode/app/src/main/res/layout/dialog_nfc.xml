<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center">

    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_dialog_white"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="36dp"
        android:paddingBottom="32dp"
        android:paddingLeft="28dp"
        android:paddingRight="28dp">

        <ImageView
            android:id="@+id/img_nfc_icon"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginBottom="20dp"
            android:src="@drawable/ic_umbrella_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="LISTO PARA ESCANEAR"
            android:textColor="@color/umbrella_blue_dark"
            android:textSize="16sp"
            android:letterSpacing="0.08"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Acerca el chip NFC a la parte trasera del dispositivo"
            android:textAlignment="center"
            android:textColor="@color/umbrella_text_secondary"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.4" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            app:indicatorColor="@color/umbrella_blue_primary"
            app:trackColor="@color/umbrella_blue_light"
            app:trackCornerRadius="4dp"
            android:indeterminate="true" />

    </LinearLayout>
</FrameLayout>